# Maximum wall-clock seconds for GCC compilation
TIMEOUT_SECONDS=10

# Max compile requests per minute per IP
RATE_LIMIT=10

# Comma-separated list of allowed CORS origins (use * for development only)
# Example: ALLOWED_ORIGINS=https://compiler.yourdomain.com
ALLOWED_ORIGINS=*

# AWS Lambda target
LAMBDA_FUNCTION_NAME=gcc-sandbox
AWS_REGION=us-east-1

# AWS credentials — leave blank if running on EC2 with an IAM instance profile.
# Never commit real credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
