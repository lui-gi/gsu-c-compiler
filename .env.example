# Maximum wall-clock seconds for compilation + execution combined
TIMEOUT_SECONDS=10

# Memory limit (MB) per sandbox container
MEMORY_MB=64

# Max compile requests per minute per IP
RATE_LIMIT=10

# Comma-separated list of allowed CORS origins (use * for development only)
# Example: ALLOWED_ORIGINS=https://compiler.yourdomain.com
ALLOWED_ORIGINS=*
